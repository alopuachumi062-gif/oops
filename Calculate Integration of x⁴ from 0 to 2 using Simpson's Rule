#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int n = 10;
    double a = 0, b = 2;
    double h, sum = 0;

    h = (b - a) / n;

    for(int i = 0; i <= n; i++)
    {
        double x = a + i * h;
        double y = pow(x, 4);

        if(i == 0 || i == n)
            sum = sum + y;
        else if(i % 2 == 0)
            sum = sum + 2 * y;
        else
            sum = sum + 4 * y;
    }

    double result = (h / 3) * sum;

    cout << "Integration = " << result;

    return 0;
}
