#include <iostream>
using namespace std;

class DynamicArray {
    int* arr;
    int size;

public:
    DynamicArray(int n) {
        size = n;
        arr = new int[size];
    }

    void input() {
        cout << "Enter " << size << " elements: ";
        for (int i = 0; i < size; i++)
            cin >> arr[i];
    }

    void display() const {
        cout << "Array elements: ";
        for (int i = 0; i < size; i++)
            cout << arr[i] << " ";
        cout << endl;
    }

    ~DynamicArray() {
        delete[] arr;
    }
};

int main() {
    int n;
    cout << "Enter array size: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid size" << endl;
        return 0;
    }

    DynamicArray a(n);
    a.input();
    a.display();

    return 0;
}
